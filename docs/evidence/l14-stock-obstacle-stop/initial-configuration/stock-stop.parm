# Retain the L13 sensor geometry; expose its front range to stock proximity.
PLND_ENABLED 0
RNGFND1_TYPE 10
RNGFND1_ORIENT 0
RNGFND1_MIN 0.2
RNGFND1_MAX 8
RNGFND1_POS_X 0.3
RNGFND1_POS_Y 0
RNGFND1_POS_Z -0.15
PRX1_TYPE 4

# Stop in stock LOITER. No route planner or backing into unobserved space.
AVOID_ENABLE 2
AVOID_BEHAVE 1
AVOID_MARGIN 2
AVOID_BACKUP_SPD 0
AVOID_ALT_MIN 0
OA_TYPE 0
LOIT_SPEED_MS 0.5
WP_SPD 1
LOG_DISARMED 1
