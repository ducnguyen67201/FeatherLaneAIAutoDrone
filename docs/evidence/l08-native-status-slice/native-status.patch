diff --git a/libraries/FL_Status/FL_Status.h b/libraries/FL_Status/FL_Status.h
new file mode 100644
index 0000000000..a675a93cdf
--- /dev/null
+++ b/libraries/FL_Status/FL_Status.h
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+
+#include <AP_HAL/AP_HAL_Boards.h>
+
+#if CONFIG_HAL_BOARD == HAL_BOARD_SITL
+#include <stdint.h>
+
+// L08 observer only: no command, controller or motor interfaces.
+class FL_Status {
+public:
+    // Called at a nominal 1 Hz; true requests the first/every fifth report.
+    bool update(uint8_t mode, bool armed);
+
+    uint32_t update_count() const { return _update_count; }
+    uint8_t mode() const { return _mode; }
+    bool armed() const { return _armed; }
+
+private:
+    uint32_t _update_count = 0;
+    uint8_t _mode = 0;
+    bool _armed = false;
+    uint8_t _report_countdown = 0;
+};
+#endif // CONFIG_HAL_BOARD == HAL_BOARD_SITL
diff --git a/libraries/FL_Status/FL_Status.cpp b/libraries/FL_Status/FL_Status.cpp
new file mode 100644
index 0000000000..d0df006d2d
--- /dev/null
+++ b/libraries/FL_Status/FL_Status.cpp
@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "FL_Status.h"
+
+#if CONFIG_HAL_BOARD == HAL_BOARD_SITL
+bool FL_Status::update(uint8_t mode, bool armed)
+{
+    _mode = mode;
+    _armed = armed;
+    ++_update_count;
+
+    if (_report_countdown > 0) {
+        --_report_countdown;
+        return false;
+    }
+
+    _report_countdown = 4;
+    return true;
+}
+#endif // CONFIG_HAL_BOARD == HAL_BOARD_SITL
