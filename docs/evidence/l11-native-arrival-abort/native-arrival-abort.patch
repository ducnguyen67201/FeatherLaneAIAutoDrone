+const char *ModeFeatherLane::task_state_name() const
+{
+    switch (_task_state) {
+    case TaskState::IDLE:
+        return "idle";
+    case TaskState::RUNNING:
+        return "running";
+    case TaskState::DWELLING:
+        return "dwelling";
+    case TaskState::COMPLETE:
+        return "complete";
+    case TaskState::ABORTED:
